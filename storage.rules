rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidMediaContentType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('video/.*') ||
             request.resource.contentType.matches('audio/.*') ||
             request.resource.contentType == 'application/json';
    }

    // User-scoped project media uploads: /users/{userId}/projects/{projectId}/{fileName}
    match /users/{userId}/projects/{projectId}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isVerifiedUser() &&
                   request.auth.uid == userId &&
                   request.resource.size <= 250 * 1024 * 1024 &&
                   isValidMediaContentType();
      allow delete: if isVerifiedUser() && request.auth.uid == userId;
    }

    // Publicly streamable verified media mirror: /media/{mediaKey}
    match /media/{mediaKey} {
      allow read: if true;
      allow write: if isVerifiedUser() &&
                   request.resource.size <= 500 * 1024 * 1024 &&
                   isValidMediaContentType();
    }
  }
}
