# 3. queue_cli.py
@'
import time
import os
import argparse
OUTPUT_FOLDER = r"C:\MarilagProject\MarilagOutput"
def run_test(duration=15):
    print(f"MARILAG QUEUE CLI - {duration} SECOND TEST START")
    if not os.path.exists(OUTPUT_FOLDER):
        os.makedirs(OUTPUT_FOLDER)
    for i in range(1, duration+1):
        print(f"Step {i}/{duration}: Queue active...")
        time.sleep(1)
    print("TEST COMPLETE! NOTE: NO ACTUAL VIDEO ENCODING YET!")
if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--sec", type=int, default=15)
    args = parser.parse_args()
    run_test(args.sec)
'@ | Set-Content \"$base\queue_cli.py\"


