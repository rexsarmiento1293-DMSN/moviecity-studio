# ============================================================================
# MARILAG RENDER QUEUE STUDIO - ENVIRONMENT VARIABLES (.env.example)
# ============================================================================
# SECURITY NOTICE:
# - Huwag maglagay ng totoong API key, OAuth secret, o token sa file na ito.
# - Kopyahin ito bilang `.env` (na nasa .gitignore) at punan ng iyong sariling keys.
# ============================================================================

# 1. Server-Side Gemini AI API Key (Mula sa AI Studio Secrets Panel)
GEMINI_API_KEY=""

# 2. Public Application Origin URL (Ginagamit sa OAuth Redirect URI)
APP_URL=""

# 3. YouTube Data API v3 Server-Side Proxy Credentials
# Kunin sa Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_API_KEY=""
YOUTUBE_OAUTH_CLIENT_ID=""
YOUTUBE_OAUTH_CLIENT_SECRET=""

# 4. Android APK Key Restriction Headers (Package Name & SHA-1 Signing Cert)
# Ginagamit ng backend proxy upang ipasa ang X-Android-Package at X-Android-Cert
ANDROID_PACKAGE_NAME=""
ANDROID_SHA1_FINGERPRINT=""

# 5. Client-Side Backend Proxy Base URL (Para sa Capacitor Android APK build)
# Halimbawa: https://your-production-backend.run.app
VITE_API_BASE_URL=""

# 6. Cloudflare Worker AI Generation Endpoint, Token Name & Client IP CIDR (Server-Side Only)
# Halimbawa: https://flat-dream-15fc.<account>.workers.dev
CF_TOKEN_NAME="flat-dream-15fc"
CF_ACCOUNT_ID=""
CF_CLIENT_IP="112.207.213.158"
CF_CLIENT_IP_CIDR="112.207.213.158/32"
CF_WORKER_URL="https://flat-dream-15fc.workers.dev"
CF_API_TOKEN=""

# 7. Cloudflare Hyperdrive Connection Configuration (Server-Side Only - Never Expose to Client)
CF_HYPERDRIVE_NAME="flat-dream-15fc-hyperdrive"
CF_HYPERDRIVE_CONNECTION_STRING=""

# 8. Supabase System & App Build Integration (Server-Side Only - Never Prefix Secrets with VITE_)
SUPABASE_PROJECT_REF="opdekwvpzwghxeqkwxlo"
SUPABASE_URL="https://opdekwvpzwghxeqkwxlo.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_DIRECT_CONNECTION_STRING=""

# 9. Hugging Face Inference API Text-to-Video Generation (Server-Side Only - Never Send to Browser)
HF_TOKEN=""
HF_VIDEO_MODEL="Wan-AI/Wan2.1-T2V-14B"

# 10. LTX-Video Cloud & Colab Bridge Router Secrets (Server-Side Only - Never Send to Browser)
FAL_KEY=""
FAL_VIDEO_MODEL="fal-ai/ltx-video"
COLAB_LTX_ENABLED="true"
COLAB_BRIDGE_TOKEN=""
COLAB_REGISTER_TOKEN=""
GEMINi_key=""


