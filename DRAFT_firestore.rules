rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidDramaProject(data) {
      return data.keys().hasAll([
        'ownerId',
        'title',
        'prompt',
        'genre',
        'status',
        'characterName',
        'characterAppearance',
        'characterStyle',
        'selectedEffect',
        'resolution',
        'includeAudio',
        'sceneCount',
        'totalDurationSec',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'title',
        'prompt',
        'genre',
        'status',
        'characterName',
        'characterAppearance',
        'characterStyle',
        'selectedEffect',
        'resolution',
        'includeAudio',
        'sceneCount',
        'totalDurationSec',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId == request.auth.uid &&
      isValidId(data.ownerId) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
      data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 2000 &&
      data.genre is string && data.genre.size() >= 1 && data.genre.size() <= 80 &&
      data.status is string && data.status in ['Draft', 'Generating', 'Done'] &&
      data.characterName is string && data.characterName.size() >= 1 && data.characterName.size() <= 100 &&
      data.characterAppearance is string && data.characterAppearance.size() >= 1 && data.characterAppearance.size() <= 500 &&
      data.characterStyle is string && data.characterStyle.size() >= 1 && data.characterStyle.size() <= 200 &&
      data.selectedEffect is string && data.selectedEffect.size() >= 1 && data.selectedEffect.size() <= 64 &&
      data.resolution is string && data.resolution in ['480p', '720p', '1080p'] &&
      data.includeAudio is bool &&
      data.sceneCount is int && data.sceneCount >= 1 && data.sceneCount <= 100 &&
      data.totalDurationSec is int && data.totalDurationSec >= 1 && data.totalDurationSec <= 3600 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidR2MediaAsset(data) {
      return data.keys().hasAll([
        'ownerId',
        'projectId',
        'r2Key',
        'bucket',
        'url',
        'mediaType',
        'prompt',
        'contentType',
        'sizeBytes',
        'model',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'projectId',
        'r2Key',
        'bucket',
        'url',
        'mediaType',
        'prompt',
        'contentType',
        'sizeBytes',
        'model',
        'createdAt'
      ]) &&
      isValidId(data.ownerId) &&
      isValidId(data.projectId) &&
      data.r2Key is string && data.r2Key.size() >= 1 && data.r2Key.size() <= 256 &&
      data.bucket is string && data.bucket == 'movie-city-media' &&
      data.url is string && data.url.size() >= 1 && data.url.size() <= 1024 &&
      data.mediaType is string && data.mediaType in ['image', 'video', 'music'] &&
      data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 2000 &&
      data.contentType is string && data.contentType.size() >= 1 && data.contentType.size() <= 120 &&
      data.sizeBytes is number && data.sizeBytes >= 1 && data.sizeBytes <= 524288000 &&
      data.model is string && data.model.size() >= 1 && data.model.size() <= 120 &&
      data.createdAt is timestamp;
    }

    match /drama_projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(projectId) &&
        isValidDramaProject(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(projectId) &&
        isValidDramaProject(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'prompt',
          'genre',
          'status',
          'characterName',
          'characterAppearance',
          'characterStyle',
          'selectedEffect',
          'resolution',
          'includeAudio',
          'sceneCount',
          'totalDurationSec',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser() &&
        isValidId(projectId) &&
        existing().ownerId == request.auth.uid;
    }

    match /r2_media_assets/{assetId} {
      allow get: if isValidId(assetId) && existing().bucket == 'movie-city-media';
      allow list: if existing().bucket == 'movie-city-media';

      allow create: if isValidId(assetId) &&
        isValidR2MediaAsset(incoming()) &&
        incoming().createdAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(assetId) &&
        isValidR2MediaAsset(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'prompt',
          'url',
          'sizeBytes',
          'contentType',
          'model'
        ]);

      allow delete: if isVerifiedUser() &&
        isValidId(assetId) &&
        existing().ownerId == request.auth.uid;
    }
  }
}
